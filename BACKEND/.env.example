# ============================================================
# AIoT Machine Health Monitoring – Backend Environment Config
# ============================================================

# Supabase project URL (from Project Settings → API)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase SERVICE ROLE key (NEVER expose this to the frontend)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Google Gemini API key
GEMINI_API_KEY=your-gemini-api-key-here

# Express server port
PORT=5000

# Frontend origin (for CORS) – e.g. http://localhost:5173
CLIENT_URL=http://localhost:5173

# Simulator interval (ms between readings per machine)
SIMULATOR_INTERVAL_MS=3000

# Anomaly-injection duration (ms)
ANOMALY_DURATION_MS=60000
